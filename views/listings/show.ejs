<% layout("/layouts/boilerplate") -%>
<body>
    <div class="row mb-3">
        <div class="col-8 offset-2">
            <div class="card col-6 offset-2 show-card card-listing" style="width: 18rem;">
                <h3><%=listing.title %></h3>
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
                <div class="card-body">
                  <p class="card-text"><%= listing.description || 'No description available' %></p>
                  <h6>&#8377;<%= listing.price.toLocaleString("en-IN") %></h6>
                  <h6><%= listing.location %></h6>
                  <h6><%= listing.country %></h6>
                </div>
              </div>  
        </div>
    </div>
    <div class="btns">
    <a class="btn btn-dark col-1 offset-3 edit-btn" href="/listings/<%=listing._id%>/edit">Edit</a>
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button  class="btn btn-dark offset-5" type="submit">Delete</button>
      </form>
    </div>
    <hr/>
    <div class="col-8 offset-3 mb-2">
      <form class="mb-3 col-15 md-4 needs-validation" action="/listings/<%=listing.id%>/reviews" method="POST" novalidate>
        <h5>Leave review</h5>
        <div class="mb-3 col-md-4"><label for="disabledRange" class="form-label">Rating</label>
        <input type="range" name="review[rating]" min="1" max="5" class="form-range" id="disabledRange" ><br></div>
         
        <div class="mb-3 col-md-4"><label for="comment" class="form-label">Comment
        <textarea id="comment" class="form-control" name="review[comment]" rows="3" cols="30" required></textarea>
        <div class="invalid-feedback">
        Please add a review.
      </div>
        </label></div>
        <br>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
      </div>
      <hr/>
       
       <h4>All Reviews</h4>
<div class="row">
  <% for (let review of listing.review) { %>
    <div class="col-md-4 mb-3 ">
      <div class="card ms-3 mb-3">
        <div class="card-body p-1">
          <h5 class="card-title">Nitish Kumar Yadav</h5>
          <p class="card-text"><%= review.comment %></p>
          <h6 class="card-subtitle mb-2 text-muted"><%= review.rating %> Star</h6>
        </div>
        <div><form method="POST" action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=DELETE">
          <button class="btn m-1 mb-1 btn-dark">Delete</button>
        </form></div>
      </div>
    </div>
  <% } %>
</div>

     </div>
</body>
